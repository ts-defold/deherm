FROM europe-west1-docker.pkg.dev/extender-426409/extender-public-registry/extender-winsdk-2026_145136231-env:1.3.0

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cmake ninja-build python3 && \
    rm -rf /var/lib/apt/lists/*
COPY upstream/hermes /src/hermes
COPY toolchains/hermes/windows-msvc.cmake /toolchain/windows-msvc.cmake
WORKDIR /work
RUN cmake -S /src/hermes -B /work/build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_TOOLCHAIN_FILE=/toolchain/windows-msvc.cmake \
      -DHERMES_ENABLE_TEST_SUITE=OFF \
      -DHERMES_ENABLE_TOOLS=OFF \
      -DHERMES_ENABLE_DEBUGGER=OFF \
      -DHERMES_ENABLE_INTL=OFF \
      -DHERMES_BUILD_SHARED_JSI=OFF && \
    cmake --build /work/build --target hermesvm_a jsi --parallel

FROM scratch
COPY --from=0 /work/build/lib/hermesvm_a.lib /hermesvm_a.lib
COPY --from=0 /work/build/jsi/jsi.lib /jsi.lib
