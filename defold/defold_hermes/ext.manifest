name: "defold_hermes"

platforms:
    arm64-osx:
        context:
            frameworks: ["CoreFoundation"]
            flags: ["-std=c++17", "-fexceptions"]
    x86_64-osx:
        context:
            frameworks: ["CoreFoundation"]
            flags: ["-std=c++17", "-fexceptions"]
    x86_64-linux:
        context:
            flags: ["-std=c++17", "-fexceptions"]
    arm64-linux:
        context:
            flags: ["-std=c++17", "-fexceptions"]
    x86_64-win32:
        context:
            flags: ["-std=c++17", "-fexceptions"]
