-- Generated gameplay-free companion for the extension delivery model.
-- Its only responsibility is to provide Defold's current script instance.
function init(self)
    self.deherm_test_exit = sys.get_config_int("deherm.test_exit", 0) ~= 0
    self.deherm_test_updates = 0
    assert(_deherm_.attach(self))
    local position = go.get_position()
    if math.abs(position.x - 13) <= 0.000001 and
       math.abs(position.y - 21) <= 0.000001 and
       math.abs(position.z - 34) <= 0.000001 then
        print("script-value:go.set_position.current:ok")
    end

    local rotation = go.get_rotation()
    if math.abs(rotation.x) <= 0.000001 and
       math.abs(rotation.y) <= 0.000001 and
       math.abs(rotation.z - 0.7071067811865476) <= 0.000001 and
       math.abs(rotation.w - 0.7071067811865476) <= 0.000001 then
        print("script-value:go.set_rotation.current:ok")
    end

    -- Addressed writes are observed from outside the TypeScript boundary: the
    -- addressed instance is a different game object in this collection, so a
    -- plain Lua read of it witnesses that the write crossed the address.
    local addressed = go.get_position("/probe_target")
    if math.abs(addressed.x - 89) <= 0.000001 and
       math.abs(addressed.y - 144) <= 0.000001 and
       math.abs(addressed.z - 233) <= 0.000001 then
        print("script-value:go.set_position.addressed-url:ok")
    end

    local addressed_rotation = go.get_rotation("/probe_target")
    if math.abs(addressed_rotation.x) <= 0.000001 and
       math.abs(addressed_rotation.y) <= 0.000001 and
       math.abs(addressed_rotation.z - 0.7071067811865476) <= 0.000001 and
       math.abs(addressed_rotation.w - 0.7071067811865476) <= 0.000001 then
        print("script-value:go.set_rotation.addressed-string:ok")
    end
end

function update(self, dt)
    _deherm_.update(self, dt)
    if self.deherm_test_exit then
        self.deherm_test_updates = self.deherm_test_updates + 1
        if self.deherm_test_updates >= 2 then
            sys.exit(0)
        end
    end
end

function final(self)
    _deherm_.detach(self)
end
