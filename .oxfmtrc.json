{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/**",
    ".deherm/**",
    "build/**",
    "dist/**",
    "upstream/**",
    "**/evidence/**",
    "**/fixtures/**",
    "**/generated/**",
    "**/generated-*/*",
    "defold/defold_hermes/**",
    "examples/*/defold/defold_hermes/**",
    "examples/*/defold/defold_hermes_typed_native/**"
  ]
}
