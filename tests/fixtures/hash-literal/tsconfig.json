{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rootDir": "../../..",
    "outDir": ".out",
    "paths": {
      "@ts-defold/deherm": ["../../../packages/sdk/src/index.ts"]
    },
    "plugins": [
      {
        "transform": "../../../packages/compiler/ttsc.mjs",
        "enabled": true
      }
    ]
  },
  "files": ["entry.ts"]
}
