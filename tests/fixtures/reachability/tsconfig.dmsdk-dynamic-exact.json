{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ts-defold/deherm": ["../../../packages/sdk/src/index.ts"]
    },
    "plugins": [
      {
        "transform": "../../../packages/compiler/ttsc.mjs",
        "enabled": true,
        "profile": "release",
        "dmsdkSymbols": "./.deherm/generated/dmsdk-call-symbol-index.json",
        "dmsdkUsage": "./.deherm/generated/dmsdk-usage.dynamic-exact.json"
      }
    ]
  },
  "include": ["dmsdk/dynamic-exact.ts"]
}
