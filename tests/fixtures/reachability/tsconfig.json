{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@ts-defold/deherm": ["../../../packages/sdk/src/index.ts"]
    },
    "plugins": [
      {
        "transform": "../../../packages/compiler/ttsc.mjs",
        "enabled": true,
        "profile": "release",
        "routeSymbols": "./.deherm/generated/script-route-symbol-index.json",
        "apiUsage": "./.deherm/generated/defold-api-usage.json"
      }
    ]
  },
  "include": ["src/**/*.ts"]
}
