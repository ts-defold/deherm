{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@deherm/abi": ["./packages/abi/src/generated/layouts.ts"],
      "@deherm/bindings": ["./packages/bindings/modules.json"],
      "@deherm/bindings/*": ["./packages/bindings/*"],
      "@deherm/cli": ["./packages/cli/src/cli.mjs"],
      "@deherm/cli/*": ["./packages/cli/src/*"],
      "@deherm/compiler": ["./packages/compiler/src/index.mjs"],
      "@deherm/compiler/*": ["./packages/compiler/src/*"],
      "@deherm/polyfills": ["./packages/polyfills/compatibility.json"],
      "@deherm/sdk": ["./packages/sdk/src/index.ts"],
      "@deherm/sdk/component": ["./packages/sdk/src/component.ts"],
      "@deherm/sdk/generated/*": ["./packages/sdk/src/generated/*"],
      "@deherm/sdk/*": ["./packages/sdk/src/generated/modules/*"],
      "@deherm/static-hermes": ["./packages/static-hermes/src/index.ts"],
      "@deherm/static-hermes/*": ["./packages/static-hermes/src/*"],
      "@deherm/telemetry": ["./packages/telemetry/schema/deherm_telemetry.proto"],
      "@deherm/web-adapter": ["./packages/web-adapter/src/host.ts"],
      "@deherm/web-adapter/*": ["./packages/web-adapter/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "examples/runtime-smoke/**/*.ts",
    "benchmarks/**/*.ts",
    "examples/war-battles-online/verification/generated/**/*.ts"
  ]
}
