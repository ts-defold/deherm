{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@defold-hermes/sdk": ["./packages/sdk/src/index.ts"],
      "@defold-hermes/sdk/*": ["./packages/sdk/src/generated/modules/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "sample/**/*.ts",
    "benchmarks/**/*.ts",
    "examples/war-battles-online/verification/generated/**/*.ts"
  ]
}
