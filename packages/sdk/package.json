{
  "name": "@deherm/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "source": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component": {
      "types": "./src/component.ts",
      "import": "./src/component.ts",
      "default": "./src/component.ts"
    },
    "./generated/*": "./src/generated/*",
    "./modules/*": "./src/generated/modules/*"
  }
}
