{
  "schemaVersion": 1,
  "hermesRevision": "4947871513667919bf2fe225134af3e3a1a3772c",
  "packageScope": "@ts-defold",
  "packageVersion": "0.0.0",
  "distribution": "optional-per-host-package",
  "note": "hermesc and shermes are pure compilers - text in, text out. shermes only emits C; Extender compiles it. Shipping them therefore imposes no native toolchain requirement on the user, and they are indexed by the user's HOST, never by the Defold bundle target.",
  "statuses": {
    "vendored": "The binaries are present for this host and match the pinned digests.",
    "required-missing": "A CI build path exists; the binaries have not been pulled into this checkout.",
    "blocked": "The binaries cannot be produced for this host yet; `blocker` names why."
  },
  "binaries": {
    "hermesc": {
      "role": "TypeScript/JavaScript to Hermes bytecode",
      "invocation": "hermesc -emit-binary -out <bundle>.hbc <program>.js"
    },
    "shermes": {
      "role": "typed TypeScript to C, compiled by Extender",
      "invocation": "shermes -typed -emit-c -o <unit>.c <program>.js"
    }
  },
  "hosts": {
    "darwin-arm64": {
      "host": {
        "platform": "darwin",
        "architecture": "arm64"
      },
      "builder": "macos-native",
      "package": "@ts-defold/deherm-compilers-darwin-arm64",
      "directory": "toolchains/host-compilers/darwin-arm64",
      "status": "required-missing",
      "files": {
        "hermesc": "bin/hermesc",
        "shermes": "bin/shermes"
      }
    },
    "darwin-x64": {
      "host": {
        "platform": "darwin",
        "architecture": "x64"
      },
      "builder": "macos-native",
      "package": "@ts-defold/deherm-compilers-darwin-x64",
      "directory": "toolchains/host-compilers/darwin-x64",
      "status": "required-missing",
      "files": {
        "hermesc": "bin/hermesc",
        "shermes": "bin/shermes"
      }
    },
    "linux-x64": {
      "host": {
        "platform": "linux",
        "architecture": "x64"
      },
      "builder": "ubuntu-2204-native",
      "package": "@ts-defold/deherm-compilers-linux-x64",
      "directory": "toolchains/host-compilers/linux-x64",
      "status": "required-missing",
      "files": {
        "hermesc": "bin/hermesc",
        "shermes": "bin/shermes"
      }
    },
    "linux-arm64": {
      "host": {
        "platform": "linux",
        "architecture": "arm64"
      },
      "builder": "ubuntu-2204-arm-native",
      "package": "@ts-defold/deherm-compilers-linux-arm64",
      "directory": "toolchains/host-compilers/linux-arm64",
      "status": "required-missing",
      "files": {
        "hermesc": "bin/hermesc",
        "shermes": "bin/shermes"
      }
    },
    "win32-x64": {
      "host": {
        "platform": "win32",
        "architecture": "x64"
      },
      "builder": "windows-msvc-native",
      "package": "@ts-defold/deherm-compilers-win32-x64",
      "directory": "toolchains/host-compilers/win32-x64",
      "status": "required-missing",
      "files": {
        "hermesc": "bin/hermesc.exe",
        "shermes": "bin/shermes.exe"
      }
    }
  },
  "glibcFloor": "The published Linux compilers are built on ubuntu-22.04 runners, so they require glibc 2.35 or newer on the user's host."
}
