{
  "schemaVersion": 1,
  "scope": "One bounded, generated value-graph fallback shared by every pending non-callback script route.",
  "selection": {
    "loweringFamilies": [
      "borrowed-handle",
      "callback-lifecycle",
      "defold-value",
      "dynamic-values",
      "lua-table",
      "multi-result",
      "overload-dispatch",
      "scalar"
    ],
    "excludedContexts": [
      "component-property-compiler"
    ],
    "excludedLoweringFamilies": [
      "separate-module"
    ],
    "callbacks": "retained-runtime-neutral-callback-descriptor",
    "variadics": "bounded-by-global-argument-capacity",
    "optimizedFamilies": "remain-on-their-specialized-lanes"
  },
  "bounds": {
    "maximumArguments": 32,
    "maximumDepth": 8,
    "maximumEntries": 256,
    "maximumStringBytes": 65536
  },
  "tablePolicy": {
    "arrays": "dense-one-based-lua-sequence",
    "objects": "own-enumerable-string-keys",
    "maps": "exact-js-map-keys",
    "cycles": "reject",
    "duplicateKeys": "last-write-is-lua-semantics",
    "unsupportedValues": "reject-before-lua-call"
  }
}
