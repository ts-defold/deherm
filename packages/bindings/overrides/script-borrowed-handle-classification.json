  "coverageClaim": "Classification and implementation-order planning only. A classified route is not runtime evidence and does not claim native, HTML5, or Static Hermes conformance.",
  "allocationClaim": "After fixed-capacity bridge registries and Lua stack/registry storage are prewarmed, the generated lookup and dispatch glue can avoid C++ heap allocation on handle-consuming calls. This does not claim that Lua, Defold, Box2D, Bullet, GUI, graphics, resource, or user callbacks are allocation-free; handle capture, object creation, table growth, and engine operations may allocate.",
  "implementationOrder": [
    {
      "order": 1,
      "operationClass": "checked-handle-input-terminal",
      "reason": "Consumes existing handles without creating bridge ownership or retiring engine identity."
    },
    {
      "order": 2,
      "operationClass": "checked-handle-return-capture",
      "reason": "Introduces concrete return-kind checks, Lua rooting, ownership policy, and finalizer behavior."
    },
    {
      "order": 3,
      "operationClass": "checked-child-engine-object-invalidate",
      "reason": "Destroys a body-owned child selected by integer index while preserving the validated parent body and its host handle."
    },
    {
      "order": 4,
      "operationClass": "checked-self-engine-object-invalidate",
      "reason": "Invalidates the wrapped engine identity after success but preserves the rooted host userdata so is_valid can observe false and native validators retain Defold semantics."
    },
    {
      "order": 5,
      "operationClass": "declaration-token",
      "reason": "Belongs in the TypeScript component/property compiler and must not be represented as a runtime handle."
    }
  ],
