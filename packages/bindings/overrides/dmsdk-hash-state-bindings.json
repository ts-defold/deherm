{
  "schemaVersion": 2,
  "policyVersion": "hash-state-v2",
  "family": "generation-checked-hash-state",
  "documentationContract": {
    "initPattern": "^Initialize hash-state for (32|64)-bit incremental hashing$",
    "clonePattern": "^Clone (32|64)-bit incremental hash state$",
    "updateSummary": "Incremental hashing",
    "finalSummary": "Finalize incremental hashing and release associated resources",
    "releaseSummaryPrefix": "Release incremental hashing resources",
    "stateDescription": "Hash state",
    "sourceStateDescription": "Source hash state",
    "bufferDescription": "Buffer",
    "bufferLengthDescription": "Length of buffer",
    "finalResultPattern": "^[Tt]he hash value$",
    "semantics": ["generation-checked-state", "incremental-hash-lifecycle", "synchronous-noescape"],
    "rationale": "Lifecycle operations are inferred from state-record ABI roles and public documentation. Width comes from result lanes or the state-record type; callable names are retained only as revision-derived linker identities."
  },
  "recipe": {
    "operations": ["Init", "Clone", "UpdateBuffer", "Final", "Release"],
    "widths": [32, 64]
  },
  "registry": {
    "capacityPerWidth": 16,
    "token": "opaque-u64-magic-width-generation-slot",
    "generationBits": 31,
    "consumeOperations": ["Final", "Release"],
    "reverseHashDefault": false,
    "threadSafety": "global-allocation-free-spin-lock",
    "generationExhaustion": "retire-slot"
  },
  "symbolEvidence": {
    "path": "packages/bindings/generated/defold-dmsdk-symbol-evidence.json",
    "requiredLinkage": "external",
    "requiredAvailability": "all-targets-all-variants"
  }
}
