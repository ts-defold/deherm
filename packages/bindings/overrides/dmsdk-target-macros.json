  "defoldRevision": "7f0f554f41f9dce1e0ddff99bf08200657d1ee05",
  "scope": "The macro assignment each Defold bundle target compiles the dmSDK under, so that a declaration gated on a platform conditional can be resolved per target instead of per deriving host.",
  "derivation": [
    "platform defines are READ from Defold's own share/extender/build_input.yml, never restated here",
    "a group's toolchain is read from the version symbol build_tools/sdk.py pins for that platform",
    "a toolchain's predefines are a property of that compiler and are the only values declared here",
    "an architecture's predefines are the ones dmSDK headers actually test: word size and byte order",
    "a macro this file does not decide makes its conditional unresolved, never false"
  ],
  "sourceEvidence": [
    {
      "id": "extender-build-input",
      "path": "share/extender/build_input.yml",
      "sha256": "75e3402cd5e42f8492ad70408143cd01a6dbd9b554efb586e32372cae771446d",
      "anchors": [
        "DM_PLATFORM_OSX",
        "DM_PLATFORM_IOS",
        "DM_PLATFORM_ANDROID",
        "DM_PLATFORM_HTML5",
        "DM_PLATFORM_LINUX",
        "DM_PLATFORM_WINDOWS"
      ],
      "reason": "Defold's own declaration of which platform defines each bundle target is compiled with. The per-target and per-group define lists are read from here; nothing in this file restates them."
    },
    {
      "id": "defold-toolchain-pins",
      "path": "build_tools/sdk.py",
      "sha256": "30ed595a5b6e8bca6f2cd8531ffe8681ce3d4bd39bf840802eb279da334b1f63",
      "anchors": [
        "VERSION_XCODE_CLANG",
        "VERSION_LINUX_CLANG",
        "ANDROID_NDK_VERSION",
        "VERSION_WINDOWS_MSVC",
        "EMSCRIPTEN_VERSION_STR"
      ],
      "reason": "Which compiler each platform is built with, and therefore which predefined macros its dmSDK translation units see. Apple and Linux are clang, Android is the NDK's clang, Windows is MSVC, web is Emscripten's clang."
    },
    {
      "id": "android-define",
      "path": "build_tools/waf_dynamo.py",
      "sha256": "d5c1eaed3e4b4d3c4a8274c171172df629d1dee33998d2acabd3f8fab87faa4d",
      "anchors": [
        "'-DANDROID', '-Wa,--noexecstack'"
      ],
      "reason": "`ANDROID` - the spelling dmsdk/dlib/android.h and dmsdk/graphics/graphics_native.h test - is not an NDK predefine. Defold's own build passes it, and this is where."
    }
  ],
