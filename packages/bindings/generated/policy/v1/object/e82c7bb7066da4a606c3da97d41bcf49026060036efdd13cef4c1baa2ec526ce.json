 sender)\n  if message_id == hash(\"animation_done\") then\n    if message.id == hash(\"jump\") then\n      -- jump animation done, chain with \"run\"\n      sprite.play_flipbook(url, \"run\")\n    end\n  end\nend\n```\n\n```lua\nfunction init(self)\n  local url = msg.url(\"#sprite\")\n  sprite.play_flipbook(url, \"jump\", anim_done)\nend\n```\n\n[Open in Browser](https://defold.com/ref/sprite-lua#sprite.play_flipbook:url-id-complete_function-play_properties)","disposition":"generated-lua-bridge","generics":[],"id":"script:sprite.play_flipbook","jsName":"playFlipbook","line":51,"member":"play_flipbook","modulePath":["sprite"],"overloads":[],"parameters":[{"description":"the sprite that should play the animation","optional":false,"rawName":"url","rawType":"string|hash|url"},{"description":"hashed id of the animation to play","optional":false,"rawName":"id","rawType":"string|hash"},{"description":"function to call when the animation has completed.  `self` `script_instance` The current script instance.  `message_id` `hash` The name of the completion message, `\"animation_done\"`.  `message` `message.sprite.animation_done` Information about the completion.  `sender` `url` The invoker of the callback: the sprite component.","optional":true,"rawName":"complete_function","rawType":"fun(self:script_instance, message_id:hash, message:message.sprite.animation_done, sender:url)"},{"description":"optional playback properties","optional":true,"rawName":"play_properties","rawType":"sprite.play_properties"}],"rawName":"sprite.play_flipbook","returnDescriptions":[],"returns":[],"runtimeStatus":"requires-universal-lua-bridge","source":"doc/sprite.lua"},{"description":"Resets a shader constant for a sprite component.\nThe constant must be defined in the material assigned to the sprite.\nResetting a constant through this function implies that the value defined in the material will be used.\nWhich sprite to reset a constant for is identified by the URL.\n\n**Examples:**\n\nThe following examples assumes that the sprite has id \"sprite\" and that the default-material in builtins is used, which defines the constant \"tint\".\nIf you assign a custom material to the sprite, you can reset the constants defined there in the same manner.\n\nHow to reset the tinting of a sprite:\n\n```lua\nfunction init(self)\n  sprite.reset_constant(\"#sprite\", \"tint\")\nend\n```\n\n[Open in Browser](https://defold.com/ref/sprite-lua#sprite.reset_constant:url-constant)","disposition":"generated-lua-bridge","generics":[],"id":"script:sprite.reset_constant","jsName":"resetConstant","line":74,"member":"reset_constant","modulePath":["sprite"],"overloads":[],"parameters":[{"description":"the sprite that should have a constant reset","optional":false,"rawName":"url","rawType":"string|hash|url"},{"description":"name of the constant","optional":false,"rawName":"constant","rawType":"string|hash"}],"rawName":"sprite.reset_constant","returnDescriptions":[],"returns":[],"runtimeStatus":"requires-universal-lua-bridge","source":"doc/sprite.lua"},{"description":"Sets horizontal flipping of the provided sprite's animations.\nThe sprite is identified by its URL.\nIf the currently playing animation is flipped by default, flipping it again will make it appear like the original texture.\n\n**Examples:**\n\nHow to flip a sprite so it faces the horizontal movement:\n\n```lua\nfunction update(self, dt)\n  -- calculate self.velocity somehow\n  sprite.set_hflip(\"#sprite\", self.velocity.x < 0)\nend\n```\n\nIt is assumed that the sprite component has id \"sprite\" and that the original animations faces right.\n\n[Open in Browser](https://defold.com/ref/sprite-lua#sprite.set_hflip:url-flip)","disposition":"generated-lua-bridge","generics":[],"id":"script:sprite.set_hflip","jsName":"setHflip","line":96,"member":"set_hflip","modulePath":["sprite"],"overloads":[],"parameters":[{"description":"the sprite that should flip its animations","optional":false,"rawName":"url","rawType":"string|hash|url"},{"description":"`true` if the sprite should flip its animations, `false` if not","optional":false,"rawName":"flip","rawType":"boolean"}],"rawName":"sprite.set_hflip","returnDescriptions":[],"returns":[],"runtimeStatus":"requires-universal-lua-bridge","source":"doc/sprite.lua"},{"description":"Sets vertical flipping of the provided sprite's animations.\nThe sprite is identified by its URL.\nIf the currently playing animation is flipped by default, flipping it again will make it appear like the original texture.\n\n**Examples:**\n\nHow to flip a sprite in a game which negates gravity as a game mechanic:\n\n```lua\nfunction update(self, dt)\n  -- calculate self.up_side_down somehow, then:\n  sprite.set_vflip(\"#sprite\", self.up_side_down)\nend\n```\n\nIt is assumed that the sprite component has id \"sprite\" and that the original animations are up-right.\n\n[Open in Browser](https://defold.com/ref/sprite-lua#sprite.set_vflip:url-flip)","disposition":"generated-lua-bridge","generics":[],"id":"script:sprite.set_vflip","jsName":"setVflip","line":118,"member":"set_vflip","modulePath":["sprite"],"overloads":[],"parameters":[{"description":"the sprite that should flip its animations","optional":false,"rawName":"url","rawType":"string|hash|url"},{"description":"`true` if the sprite should flip its animations, `false` if not","optional":false,"rawName":"flip","rawType":"boolean"}],"rawName":"sprite.set_vflip","returnDescriptions":[],"returns":[],"runtimeStatus":"requires-universal-lua-bridge","source":"doc/sprite.lua"}],"types":[{"description":"","disposition":"generated-type","fields":[],"kind":"class","line":12,"name":"defold_api.sprite","source":"doc/sprite.lua"},{"description":"Post this message to a sound-component to make it stop playing all active voices\n\n**Examples:**\n\nAssuming the script belongs to an instance with a sound-component with id \"sound\", this will make the component stop all playing voices:\n\n```lua\nmsg.post(\"#sound\", \"stop_sound\")\n```\n\n[Open in Browser](https://defold.com/ref/sound-lua#stop_sound)","disposition":"generated-type","fields":[{"description":"This message is sent to the sender of a `play_animation` message when the\nanimation has completed.\n\nNote that this message is sent only for animations that play with the following\nplayback modes:\n\n- Once Forward\n- Once Backward\n- Once Ping Pong\n\nSee `play_animation` for more information and examples of how to use\nthis message.\n\n**Examples:**\n\nHow to sequence two animations together.\n\n```lua\nfunction init(self)\n  -- play jump animation at init\n  msg.post(\"#sprite\", \"play_animation\", {id = hash(\"jump\")})\nend\n\nfunction on_message(self, message_id, message, sender)\n  -- check for animation done response\n  if message_id == hash(\"animation_done\") then\n    -- start the walk animation\n    msg.post(\"#sprite\", \"play_animation\", { id = hash(\"walk\") })\n  end\nend\n```\n\n[Open in Browser](https://defold.com/ref/sprite-lua#animation_done)\nthe current tile of the sprite","line":3179,"optional":false,"rawName":"current_tile","rawType":"number","source":"doc/meta.lua"},{"description":"id of the animation that was completed","line":3180,"optional":false,"rawName":"id","rawType":"hash","source":"doc/meta.lua"}],"kind":"class","line":3145,"name":"message.sprite.animation_done","source":"doc/meta.lua"},{"description":"","disposition":"generated-type","fields":[{"description":"Post this message to a sprite component to make it play an animation from its tile set.\n\n**Examples:**\n\nIn the example, it is assumed that the instance of the script has a sprite-component with id \"sprite\". The sprite itself is assumed to be bound to a tile set with animations \"walk\" and \"jump\".\n\n```lua\nmsg.post(\"#sprite\", \"play_animation\", {id = hash(\"jump\")})\n```\n\n[Open in Browser](https://defold.com/ref/sprite-lua#play_animation)\nthe id of the animation to play","line":3194,"optional":false,"rawName":"id","rawType":"hash","source":"doc/meta.lua"},{"description":"the normalized initial value of the animation cursor when the animation starts playing","line":3195,"optional":false,"rawName":"offset","rawType":"number","source":"doc/meta.lua"},{"description":"the rate with which the animation will be played. Must be positive","line":3196,"optional":false,"rawName":"playback_rate","rawType":"number","source":"doc/meta.lua"}],"kind":"class","line":3182,"name":"message.sprite.play_animation","source":"doc/meta.lua"},{"description":"","disposition":"generated-type","fields":[{"description":"Sprite flipbook playback properties\n\n[Open in Browser](https://defold.com/ref/sprite-lua#sprite.play_properties)\nNormalized initial animation cursor.","line":1962,"optional":true,"rawName":"offset","rawType":"number","source":"doc/meta.lua"},{"description":"Positive animation playback rate.","line":1963,"optional":true,"rawName":"playback_rate","rawType":"number","source":"doc/meta.lua"}],"kind":"class","line":1958,"name":"sprite.play_properties","source":"doc/meta.lua"}]}}