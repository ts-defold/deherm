  "dependencies": {
    "@ts-defold/deherm": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  }
}
