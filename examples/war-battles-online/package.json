{
  "name": "@deherm/example-war-battles-online",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "source": "./core/index.ts",
  "exports": {
    ".": "./core/index.ts"
  },
  "scripts": {
    "sound": "node tools/generate-sound.mjs",
    "sound:check": "node tools/generate-sound.mjs --check",
    "art": "node tools/generate-art.mjs",
    "art:check": "node tools/generate-art.mjs --check",
    "tilemap": "node tools/generate-arena-tilemap.mjs",
    "tilemap:check": "node tools/generate-arena-tilemap.mjs --check",
    "sync": "node integration/sync-defold-sources.mjs",
    "sync:check": "node integration/sync-defold-sources.mjs --check",
    "generate": "deherm generate --project defold && pnpm sync && node integration/generate-capability-snapshot.mjs",
    "verify:generated": "deherm verify-generated --project defold && pnpm sync:check && pnpm art:check && pnpm sound:check && pnpm tilemap:check && node integration/generate-capability-snapshot.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && deherm typecheck --project defold",
    "test": "node --test test/core.test.mjs test/integration.test.mjs test/hmr-state-soak.test.mjs test/packaged-runtime-evidence.test.mjs test/webtransport-evidence.test.mjs test/authoritative-load.test.mjs",
    "check": "pnpm verify:generated && pnpm typecheck && pnpm test",
    "serve": "deno run --unstable-net --allow-net --allow-read --allow-write --allow-env server/deno-main.ts",
    "play:headless": "node headless/run-match.mjs --players 32 --ticks 3600 --seed 12648430",
    "soak": "node headless/run-match.mjs --players 32 --ticks 36000 --seed 12648430",
    "bundle:size": "node headless/measure-bundles.mjs",
    "bundle:size:update": "node headless/measure-bundles.mjs --write",
    "play": "node integration/play-packaged.mjs",
    "runtime:packaged": "node integration/check-packaged-runtime.mjs",
    "runtime:debug": "node integration/check-debug-runtime.mjs",
    "runtime:debug:browser": "node integration/check-browser-debug-runtime.mjs",
    "runtime:browser": "node integration/check-browser-runtime.mjs",
    "runtime:webtransport": "node integration/check-real-webtransport.mjs",
    "runtime:webtransport:check": "node integration/check-real-webtransport.mjs --check-evidence",
    "runtime:webtransport:sources": "node integration/check-real-webtransport.mjs --check-sources",
    "runtime:load": "node integration/check-authoritative-load.mjs --json",
    "runtime:load:record": "node integration/check-authoritative-load.mjs --record-evidence",
    "runtime:load:check": "node integration/check-authoritative-load.mjs --check-evidence",
    "runtime:load:sources": "node integration/check-authoritative-load.mjs --check-sources",
    "runtime:browser:playability": "node integration/check-browser-playability.mjs",
    "runtime:browser:record": "node integration/check-browser-runtime.mjs --record-evidence",
    "runtime:browser:check": "node integration/check-browser-runtime.mjs --check-evidence",
    "runtime:installed-hmr": "node integration/check-installed-hmr.mjs",
    "runtime:installed-hmr:record": "node integration/check-installed-hmr.mjs --record-evidence",
    "runtime:installed-hmr:check": "node integration/check-installed-hmr.mjs --check-evidence",
    "runtime:packaged:record": "node integration/check-packaged-runtime.mjs --record-evidence",
    "runtime:packaged:check": "node integration/check-packaged-runtime.mjs --check-evidence",
    "runtime:typed-native": "node integration/check-typed-native-transport.mjs",
    "runtime:projections": "node integration/check-projection-evidence.mjs",
    "dev": "deherm dev --project defold --entry main/player.script.ts --watch . --build-server http://127.0.0.1:9010"
  },
  "dependencies": {
    "@ts-defold/deherm": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "7.0.2"
  }
}
