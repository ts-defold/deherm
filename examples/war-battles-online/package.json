    "runtime:network:diagnose": "node integration/diagnose-network-corrections.mjs",
    "runtime:network-matrix:record": "node integration/check-network-impairment.mjs --record-evidence",
    "runtime:network-matrix:check": "node integration/check-network-impairment.mjs --check-evidence",
    "performance": "node integration/check-performance.mjs --json",
    "performance:record": "node integration/check-performance.mjs --record-evidence",
    "performance:check": "node integration/check-performance.mjs --check-evidence",
    "performance:sources": "node integration/check-performance.mjs --check-sources",
