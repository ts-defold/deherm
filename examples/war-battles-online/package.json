    "runtime:browser:online:impaired:motion": "node integration/check-packaged-online.mjs --latency --loss --motion",
    "runtime:browser:online:impaired:soak": "node integration/check-packaged-online.mjs --latency --loss --motion --soak",
    "runtime:browser:online:impaired:video": "node integration/check-packaged-online.mjs --latency --loss --motion --video",
    "runtime:browser:online:fallback": "node integration/check-packaged-online.mjs --fallback",
