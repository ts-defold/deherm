{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "transform": "@ts-defold/deherm/ttsc",
        "enabled": true,
        "inventory": "./.deherm/extensions.json",
        "resourceSymbols": "./.deherm/generated/resource-symbols.json",
        "routeSymbols": "./.deherm/generated/script-route-symbol-index.json",
        "apiUsage": "./.deherm/generated/defold-api-usage.json",
        "dmsdkSymbols": "./.deherm/generated/dmsdk-call-symbol-index.json",
        "dmsdkUsage": "./.deherm/generated/dmsdk-usage.json",
        "profile": "release"
      }
    ],
    "paths": {
      "@deherm/project": [
        "./.deherm/sdk/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    ".deherm/**/*.ts"
  ],
  "exclude": [
    "node_modules/**",
    ".internal/**",
    "build/**",
    "dist/**",
    ".deherm/cache/**/*.ts",
    ".deherm/static-hermes/**/*.ts",
    ".deherm/generated/native-extensions/**/*.ts",
    ".deherm/build/generated/typed-native/**/*.ts",
    "defold_webtransport/webtransport/**/*.ts",
    "defold_webtransport/webtransport/static/WebTransport.ts",
    "defold_webtransport/webtransport/typescript/WebTransport.ts"
  ]
}
