{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "transform": "@ts-defold/deherm/ttsc",
        "enabled": true,
        "inventory": "./.deherm/extensions.json",
        "resourceSymbols": "./.deherm/generated/resource-symbols.json",
        "profile": "development"
      }
    ]
  }
}
