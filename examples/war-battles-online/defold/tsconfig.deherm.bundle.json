{
  "extends": "./tsconfig.deherm.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@deherm/project": [
        "./.deherm/sdk/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    ".deherm/**/*.ts"
  ],
  "exclude": [
    "node_modules/**",
    ".internal/**",
    "build/**",
    "dist/**",
    ".deherm/cache/**/*.ts",
    ".deherm/static-hermes/**/*.ts",
    ".deherm/generated/native-extensions/**/*.ts",
    ".deherm/build/generated/typed-native/**/*.ts",
    "defold_webtransport/webtransport/**/*.ts",
    "defold_webtransport/webtransport/static/WebTransport.ts",
    "defold_webtransport/webtransport/typescript/WebTransport.ts"
  ]
}
