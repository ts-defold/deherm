{
  "extends": "./tsconfig.deherm.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@deherm/project": [
        "./.deherm/sdk/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    ".deherm/**/*.ts"
  ],
  "exclude": [
    "node_modules/**",
    ".internal/**",
    "build/**",
    "dist/**",
    ".deherm/static-hermes/**/*.ts",
    ".deherm/build/generated/typed-native/**/*.ts"
  ]
}
