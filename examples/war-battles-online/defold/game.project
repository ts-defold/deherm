[project]
title = War Battles
version = 0.3.0
custom_resources = /deherm

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1280
height = 720
high_dpi = 1

[physics]
scale = 0.02

[script]
shared_state = 1

[tilemap]
max_tile_count = 4096

[library]
include_dirs = defold_hermes

[defold_hermes]
app = /deherm/app.dehermc
