totype","line":127,"member":"set_prototype","modulePath":["factory"],"overloads":[],"parameters":[{"description":"the factory component","optional":true,"rawName":"url","rawType":"string|hash|url"},{"description":"the path to the new prototype, or `nil`","optional":true,"rawName":"prototype","rawType":"string|nil"}],"rawName":"factory.set_prototype","returnDescriptions":[],"returns":[],"runtimeStatus":"requires-universal-lua-bridge","source":"doc/factory.lua"},{"description":"This decreases the reference count for each resource loaded with factory.load. If reference is zero, the resource is destroyed.\n\nCalling this function when the factory is not marked as dynamic loading does nothing.\n\n**Examples:**\n\nHow to unload resources of a factory prototype loaded with factory.load\n\n```lua\nfactory.unload(\"#factory\")\n```\n\n[Open in Browser](https://defold.com/ref/factory-lua#factory.unload:url)","disposition":"generated-lua-bridge","generics":[],"id":"script:factory.unload","jsName":"unload","line":143,"member":"unload","modulePath":["factory"],"overloads":[],"parameters":[{"description":"the factory component to unload","optional":true,"rawName":"url","rawType":"string|hash|url"}],"rawName":"factory.unload","returnDescriptions":[],"returns":[],"runtimeStatus":"requires-universal-lua-bridge","source":"doc/factory.lua"}],"types":[{"description":"","disposition":"generated-type","fields":[{"description":"Functions for controlling factory components which are used to\ndynamically spawn game objects into the runtime.\nThe factory resources are loaded.\n\n[Open in Browser](https://defold.com/ref/factory-lua#factory.STATUS)","line":18,"optional":false,"rawName":"STATUS_LOADED","rawType":"factory.STATUS","source":"doc/factory.lua"},{"description":"The factory resources are loading.\n\n[Open in Browser](https://defold.com/ref/factory-lua#factory.STATUS)","line":22,"optional":false,"rawName":"STATUS_LOADING","rawType":"factory.STATUS","source":"doc/factory.lua"},{"descrip