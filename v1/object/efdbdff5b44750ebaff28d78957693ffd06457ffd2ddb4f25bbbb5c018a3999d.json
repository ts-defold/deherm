tFromLua"],"evidence":"checked","optional":false,"types":["goinstance","nil","string","url"]},"index":1,"optionality":{"classification":"documentation-permits-refused-call","correction":"require-slot","defect":"declaration","reason":"declared optional, derived required from checked accessor dmScript::GetComponentFromLua","severity":"blocking","verdict":"disagree"},"type":{"reason":"unmapped-derived-type:goinstance","verdict":"undecided"},"verdict":"disagree"}],"registration":{"array":"FACTORY_COMP_FUNCTIONS","guard":null,"line":464,"path":"gamesys/src/gamesys/scripts/script_factory.cpp"},"results":{"declared":0,"derived":{"max":0,"min":0},"verdict":"agree"},"undecided":0,"verdict":"disagree"}]}},"schemaVersion":1,"script":{"functions":[{"description":"| `factory.STATUS_LOADED`\n| `factory.STATUS_LOADING`\n| `factory.STATUS_UNLOADED`\nThe URL identifies which factory should create the game object.\nIf the game object is created inside of the frame (e.g. from an update callback), the game object will be created instantly, but none of its component will be updated in the same frame.\n\nProperties defined in scripts in the created game object can be overridden through the properties-parameter below.\nSee go.property for more information on script properties.\n\nCalling `factory.create` on a factory that is marked as dynamic without having loaded resources\nusing `factory.load` will synchronously load and create resources which may affect application performance.\n\n**Examples:**\n\nHow to create a new game object:\n\n```lua\nfunction init(self)\n    -- create a new game object and provide property values\n    self.my_created_object = factory.create(\"#factory\", nil, nil, {my_value = 1})\n    -- communicate with the object\n    msg.post(self.my_created_object, \"hello\")\nend\n```\n\nAnd then let the new game object have a script attached:\n\n```lua\ngo.property(\"my_value\", 0)\n\nfunction init(self)\n    -- do something with self.my_value which is now one\nend\n```\n\n[Open in Browser](https://defold.com/ref/factory-lua#factory.create:url-position-rotation-properties-scale)","disposition":"generated-lua-bridge","generics":[],"id":"script:factory.create","jsName":"create","line":83,"member":"create","modulePath":["factory"],"overloads":[],"parameters":[{"description":"the factory that should create a game object.","optional":false,"rawName":"url","rawType":"string|hash|url"},{"description":"the position of the new game object, the position of the game object calling `factory.create()` is used by default, or if the value is `nil`.","optional":true,"rawName":"position","rawType":"vector3"},{"description":"the rotation of the new game object, the rotation of the game object calling `factory.create()` is used by default, or if the value is `nil`.","optional":true,"rawName":"rotation","rawType":"quaternion"},{"description":"the properties defined in a script attached to the new game object.","optional":true,"rawName":"properties","rawType":"table<string|hash, any>"},{"description":"the scale of the new game object (must be greater than 0), the scale of the game object containing the factory is used by default, or if the value is `nil`","optional":true,"rawName":"scale","rawType":"number|vector3"}],"rawName":"factory.create","returnDescriptions":["id the global id of the spawned game object"],"returns":["hash"],"runtimeStatus":"requires-universal-lua-bridge","source":"doc/factory.lua"},{"description":"This returns status of the factory.\n\nCalling this function when the factory is not marked as dynamic loading always returns\nfactory.STATUS_LOADED.\n\n[Open in Browser](https://defold.com/ref/factory-lua#factory.get_status:url)","disposition":"generated-lua-bridge","generics":[],"id":"script:factory.get_status","jsName":"getStatus","line":93,"member":"get_status","modulePath":["factory"],"overloads":[],"parameters":[{"description":"the factory component to get status from","optional":true,"rawName":"url","rawType":"string|hash|url"}],"r