ing failed; result.error contains the reason.\n\n[Open in Browser](https://defold.com/ref/recorder-lua#recorder.EVENT)","line":24,"optional":false,"rawName":"EVENT_ERROR","rawType":"recorder.EVENT","source":"doc/recorder.lua"},{"description":"Recording has started.\n\n[Open in Browser](https://defold.com/ref/recorder-lua#recorder.EVENT)","line":28,"optional":false,"rawName":"EVENT_STARTED","rawType":"recorder.EVENT","source":"doc/recorder.lua"},{"description":"Recording has stopped and the MP4 is ready to read.\n\n[Open in Browser](https://defold.com/ref/recorder-lua#recorder.EVENT)","line":32,"optional":false,"rawName":"EVENT_STOPPED","rawType":"recorder.EVENT","source":"doc/recorder.lua"}],"kind":"class","line":12,"name":"defold_api.recorder","source":"doc/recorder.lua"},{"description":"","disposition":"generated-type","kind":"enum","line":35,"name":"defold_enum.recorder.EVENT","rawType":"integer","source":"doc/recorder.lua"},{"description":"recording events\n\n[Open in Browser](https://defold.com/ref/recorder-lua#recorder.EVENT)","disposition":"generated-type","kind":"alias","line":45,"name":"recorder.EVENT","rawType":"defold_enum.recorder.EVENT","source":"doc/recorder.lua"},{"description":"","disposition":"generated-type","fields":[{"description":"recording options\n\n[Open in Browser](https://defold.com/ref/recorder-lua#recorder.options)\nWritable MP4 output path, for example from `sys.get_save_file`. Uses the host path encoding (Windows ANSI code page; UTF-8 elsewhere). The parent directory must exist.","line":1577,"optional":false,"rawName":"path","rawType":"string","source":"doc/meta.lua"},{"description":"Capture rate from 1 to 60; defaults to 30.","line":1578,"optional":true,"rawName":"fps","rawType":"integer","source":"doc/meta.lua"},{"description":"Record application audio; defaults to false.","line":1579,"optional":true,"rawName":"audio","rawType":"boolean","source":"doc/meta.lua"}],"kind":"class","line":1573,"name":"recorder.options","source":"doc/meta.