w to unload the previous prototypes resources, and then spawn a new collection\n\n```lua\ncollectionfactory.unload(\"#factory\") -- unload the previous resources\ncollectionfactory.set_prototype(\"#factory\", \"/main/levels/level1.collectionc\")\nlocal ids = collectionfactory.create(\"#factory\", go.get_world_position(), vmath.quat())\n```\n\n[Open in Browser](https://defold.com/ref/collectionfactory-lua#collectionfactory.set_prototype:url-prototype)","disposition":"generated-lua-bridge","generics":[],"id":"script:collectionfactory.set_prototype","jsName":"setPrototype","line":154,"member":"set_prototype","modulePath":["collectionfactory"],"overloads":[],"parameters":[{"description":"the collection factory component","optional":true,"rawName":"url","rawType":"string|hash|url"},{"description":"the path to the new prototype, or `nil`","optional":true,"rawName":"prototype","rawType":"string|nil"}],"rawName":"collectionfactory.set_prototype","returnDescriptions":[],"returns":[],"runtimeStatus":"requires-universal-lua-bridge","source":"doc/collectionfactory.lua"},{"description":"This decreases the reference count for each resource loaded with collectionfactory.load. If reference is zero, the resource is destroyed.\n\nCalling this function when the factory is not marked as dynamic loading does nothing.\n\n**Examples:**\n\nHow to unload resources of a collection factory prototype loaded with collectionfactory.load\n\n```lua\ncollectionfactory.unload(\"#factory\")\n```\n\n[Open in Browser](https://defold.com/ref/collectionfactory-lua#collectionfactory.unload:url)","disposition":"generated-lua-bridge","generics":[],"id":"script:collectionfactory.unload","jsName":"unload","line":170,"member":"unload","modulePath":["collectionfactory"],"overloads":[],"parameters":[{"description":"the collection factory component to unload","optional":true,"rawName":"url","rawType":"string|hash|url"}],"rawName":"collectionfactory.unload","returnDescriptions":[],"returns":[],"runtimeStatus":"req